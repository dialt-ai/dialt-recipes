DIALT_API_KEY=ck_replace_me
TWILIO_AUTH_TOKEN=replace_me
PUBLIC_BASE_URL=https://voice.example.com
# Required: who the agent is and what it does. Dialt's prompt states no role of its own.
DIALT_INSTRUCTIONS=You answer the phone for an online store. Help callers check and change their orders. When a request is unclear, ask one short clarifying question.
# DIALT_URL=wss://api.dialt.com/v1/realtime  # production default; leave unset to follow SDK updates
# DIALT_VOICE=
# DIALT_GREETING=Hello, how can I help?   # spoken on pickup; the agent's first turn, in its context, interruptible

# Optional customer-controlled human handoff. Set both values; the URL must return TwiML.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_HUMAN_HANDOFF_URL=https://voice.example.com/handoff
