DIALT_API_KEY=ck_replace_me
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+15551234567
PUBLIC_BASE_URL=https://voice.example.com

# Optional Dialt endpoint and roster voice.
# DIALT_URL=wss://dialt.com/ws
# DIALT_VOICE=

# Connect only Twilio AMD results classified as human (default), or disable AMD with "off".
# OUTBOUND_MACHINE_DETECTION=human-only

# Optional bounded ring timeout, destination-country allowlist, local calling window,
# concurrency limit, and local SQLite state path.
# OUTBOUND_RING_TIMEOUT_S=30
# OUTBOUND_ALLOWED_COUNTRIES=US
# OUTBOUND_CALLING_WINDOW_START=09:00
# OUTBOUND_CALLING_WINDOW_END=20:00
# OUTBOUND_MAX_ACTIVE_CALLS=1
# OUTBOUND_STATE_DB=outbound_calls.sqlite3
