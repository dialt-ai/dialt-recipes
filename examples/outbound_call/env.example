DIALT_API_KEY=ck_replace_me
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+15551234567
PUBLIC_BASE_URL=https://voice.example.com

# Optional server-owned business identity, Dialt endpoint, and roster voice.
# OUTBOUND_BUSINESS_NAME=Example Service Center
# DIALT_URL=wss://api.dialt.com/v1/realtime
# DIALT_VOICE=

# Connect only Twilio AMD results classified as human (default), or disable AMD with "off".
# OUTBOUND_MACHINE_DETECTION=human-only

# Optional bounded ring and connected-call durations, destination-country allowlist, local
# calling window, concurrency limit, and local SQLite state path.
# OUTBOUND_RING_TIMEOUT_S=30
# OUTBOUND_CALL_TIME_LIMIT_S=180
# OUTBOUND_ALLOWED_COUNTRIES=US
# OUTBOUND_CALLING_WINDOW_START=09:00
# OUTBOUND_CALLING_WINDOW_END=20:00
# OUTBOUND_MAX_ACTIVE_CALLS=1
# OUTBOUND_STATE_DB=outbound_calls.sqlite3
